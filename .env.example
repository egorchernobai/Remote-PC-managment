POSTGRES_DB=rmm_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

PORT=8443
USE_TLS=true

SECRET_KEY=change-this-flask-secret
JWT_SECRET_KEY=change-this-jwt-secret
ADMIN_PASSWORD=Admin_Win_123!

# Public IP/domain used in generated server certificate SANs and agent packages.
# For LAN Docker on Windows, prefer: powershell -ExecutionPolicy Bypass -File scripts/docker-lan.ps1 -Build
# Example: SERVER_PUBLIC_HOSTS=192.168.1.50,203.0.113.10,rmm.example.com
SERVER_PUBLIC_HOSTS=192.168.1.109

# Optional override for config.json inside downloaded agent package.
# Example: AGENT_SERVER_HOST=192.168.1.50:8443
AGENT_SERVER_HOST=192.168.1.109

# Set true to regenerate CA/server/agent certificates on next server start.
CERT_FORCE_RENEW=false
